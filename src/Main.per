TOPMENU
  GROUP file (TEXT = "File")
    COMMAND quit (TEXT = "Quit", IMAGE = "fa-power-off")
  END
  GROUP go (TEXT = "Sales")
    COMMAND orders        (TEXT = "Sales Orders")
    COMMAND customers     (TEXT = "Customers")
    COMMAND salespersons  (TEXT = "Sales Persons")
    COMMAND territories   (TEXT = "Territories")
    COMMAND offers        (TEXT = "Special Offers")
  END
END

LAYOUT (TEXT = "AdventureWorks Sales")
  VBOX
    GROUP (TEXT = "Sales Management")
      GRID
      {
        [bOrders                     ]
        [bCustomers                  ]
        [bSalesPersons               ]
        [bTerritories                ]
        [bOffers                     ]
      }
      END
    END
  END
END

ATTRIBUTES
  BUTTON bOrders:       orders,       TEXT = "Sales Orders",   IMAGE = "fa-shopping-cart";
  BUTTON bCustomers:    customers,    TEXT = "Customers",      IMAGE = "fa-users";
  BUTTON bSalesPersons: salespersons, TEXT = "Sales Persons",  IMAGE = "fa-id-badge";
  BUTTON bTerritories:  territories,  TEXT = "Territories",    IMAGE = "fa-globe";
  BUTTON bOffers:       offers,       TEXT = "Special Offers", IMAGE = "fa-tags";
END
