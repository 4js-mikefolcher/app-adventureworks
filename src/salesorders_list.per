SCHEMA adventureworks

LAYOUT (TEXT = "Sales Orders")
  VBOX
    GROUP (TEXT = "Search criteria")
      GRID
      {
        Order ID: [q_soid      ]    Customer ID: [q_cust      ]
      }
      END
    END
    GROUP (TEXT = "Orders")
      TABLE
      {
       ID         Order #         Date          Customer                              Status          Total Due
      [o_id      |o_num          |o_date       |o_cust                               |o_status       |o_total        ]
      }
      END
    END
  END
END

TABLES
  salesorderheader
END

ATTRIBUTES
  EDIT q_soid = salesorderheader.salesorderid;
  EDIT q_cust = salesorderheader.customerid;

  EDIT     o_id     = FORMONLY.o_id     TYPE INTEGER,       NOENTRY;
  EDIT     o_num    = FORMONLY.o_num    TYPE VARCHAR,       NOENTRY;
  DATEEDIT o_date   = FORMONLY.o_date   TYPE DATE,          NOENTRY;
  EDIT     o_cust   = FORMONLY.o_cust   TYPE VARCHAR,       NOENTRY;
  EDIT     o_status = FORMONLY.o_status TYPE VARCHAR,       NOENTRY;
  EDIT     o_total  = FORMONLY.o_total  TYPE DECIMAL(20,4), NOENTRY;
END

INSTRUCTIONS
  SCREEN RECORD sr_orders(o_id, o_num, o_date, o_cust, o_status, o_total);
END
