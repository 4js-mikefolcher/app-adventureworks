LAYOUT (TEXT = "Sales Territories")
  VBOX
    TABLE
    {
     ID     Name                      Country  Group              Sales YTD          Last Year
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    [c1    |c2                       |c3      |c4                |c5                |c6               ]
    }
    END
  END
END

ATTRIBUTES
  EDIT c1 = FORMONLY.territoryId       TYPE INTEGER,       NOENTRY;
  EDIT c2 = FORMONLY.name              TYPE VARCHAR,       REQUIRED;
  EDIT c3 = FORMONLY.countryRegionCode TYPE VARCHAR,       REQUIRED, UPSHIFT;
  EDIT c4 = FORMONLY.groupName         TYPE VARCHAR,       REQUIRED;
  EDIT c5 = FORMONLY.salesYtd          TYPE DECIMAL(20,4), NOENTRY;
  EDIT c6 = FORMONLY.salesLastYear     TYPE DECIMAL(20,4), NOENTRY;
END

INSTRUCTIONS
  SCREEN RECORD srTerritories(territoryId, name, countryRegionCode, groupName, salesYtd, salesLastYear);
END
