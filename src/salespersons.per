LAYOUT (TEXT = "Sales Persons")
  VBOX
    TABLE
    {
     ID       Name                                 Territory          Quota             Bonus            Comm%       Sales YTD
    [c_id    |c_name                              |c_terr            |c_quota          |c_bonus         |c_comm     |c_ytd            ]
    }
    END
  END
END

ATTRIBUTES
  EDIT     c_id    = FORMONLY.businessentityid TYPE INTEGER,       NOENTRY;
  EDIT     c_name  = FORMONLY.spname           TYPE VARCHAR,       NOENTRY;
  COMBOBOX c_terr  = FORMONLY.territoryid      TYPE INTEGER;
  EDIT     c_quota = FORMONLY.salesquota       TYPE DECIMAL(20,4);
  EDIT     c_bonus = FORMONLY.bonus            TYPE DECIMAL(20,4), REQUIRED;
  EDIT     c_comm  = FORMONLY.commissionpct    TYPE DECIMAL(10,4), REQUIRED;
  EDIT     c_ytd   = FORMONLY.salesytd         TYPE DECIMAL(20,4), NOENTRY;
END

INSTRUCTIONS
  SCREEN RECORD sr_sp(businessentityid, spname, territoryid, salesquota,
                      bonus, commissionpct, salesytd);
END
