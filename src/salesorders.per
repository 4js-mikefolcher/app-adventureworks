LAYOUT (TEXT = "Sales Order")
  VBOX
    GROUP (TEXT = "Order")
      GRID
      {
        Order #:      [f_sonum        ]      Order Date: [f_odate     ]
        Customer:     [f_cust                                              ]
        Status:       [f_status              ]   Ship Date:  [f_shipdate  ]
        Sales Person: [f_sp                  ]   Territory:  [f_terr            ]
        Comment:      [f_comment                                           ]
      }
      END
    END
    GROUP (TEXT = "Line Items")
      TABLE
      {
       Product                              Offer                  Qty      Unit Price       Disc        Line Total
      [l_prod                              |l_offer               |l_qty   |l_price         |l_disc     |l_total        ]
      }
      END
    END
    GROUP (TEXT = "Totals")
      GRID
      {
        Subtotal: [f_subtotal     ]   Tax: [f_tax        ]   Freight: [f_freight    ]   Total Due: [f_total      ]
      }
      END
    END
  END
END

ATTRIBUTES
  EDIT     f_sonum    = FORMONLY.salesordernumber TYPE VARCHAR,       NOENTRY;
  DATEEDIT f_odate    = FORMONLY.orderdate        TYPE DATE,          NOENTRY;
  EDIT     f_cust     = FORMONLY.custname         TYPE VARCHAR,       NOENTRY;
  COMBOBOX f_status   = FORMONLY.status           TYPE INTEGER;
  DATEEDIT f_shipdate = FORMONLY.shipdate         TYPE DATE;
  COMBOBOX f_sp       = FORMONLY.salespersonid    TYPE INTEGER;
  COMBOBOX f_terr     = FORMONLY.territoryid      TYPE INTEGER;
  EDIT     f_comment  = FORMONLY.comment          TYPE VARCHAR;
  EDIT     f_subtotal = FORMONLY.subtotal         TYPE DECIMAL(20,4), NOENTRY;
  EDIT     f_tax      = FORMONLY.taxamt           TYPE DECIMAL(20,4), NOENTRY;
  EDIT     f_freight  = FORMONLY.freight          TYPE DECIMAL(20,4), NOENTRY;
  EDIT     f_total    = FORMONLY.totaldue         TYPE DECIMAL(20,4), NOENTRY;

  COMBOBOX l_prod  = FORMONLY.productid         TYPE INTEGER,       REQUIRED;
  COMBOBOX l_offer = FORMONLY.specialofferid    TYPE INTEGER,       NOENTRY;
  EDIT     l_qty   = FORMONLY.orderqty          TYPE INTEGER,       REQUIRED;
  EDIT     l_price = FORMONLY.unitprice         TYPE DECIMAL(20,4), REQUIRED;
  EDIT     l_disc  = FORMONLY.unitpricediscount TYPE DECIMAL(10,4);
  EDIT     l_total = FORMONLY.linetotal         TYPE DECIMAL(20,4), NOENTRY;
END

INSTRUCTIONS
  SCREEN RECORD sr_hdr(salesordernumber, orderdate, custname, status, shipdate,
                       salespersonid, territoryid, comment, subtotal, taxamt,
                       freight, totaldue);
  SCREEN RECORD sr_lines(productid, specialofferid, orderqty, unitprice,
                         unitpricediscount, linetotal);
END
